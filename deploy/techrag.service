# systemd unit for the web UI/API. Adjust User and paths, then:
#   sudo cp deploy/techrag.service /etc/systemd/system/ && sudo systemctl enable --now techrag
# Ollama ships its own unit (ollama.service) when installed with the official tarball/installer.
[Unit]
Description=techrag - offline standards RAG (web UI + API)
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=techrag
WorkingDirectory=/opt/techrag
Environment=TECHRAG_CONFIG=/opt/techrag/config/config.yaml
ExecStart=/opt/techrag/.venv/bin/techrag serve --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
